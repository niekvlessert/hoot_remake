			<title code="0x15">SCENARIO.MDS : </title>
			<title code="0x10">CEREMONY.MDS : </title>
			<title code="0x11">ENDING.MDS   : </title>
			<title code="0x12">MV_03.MDS    : </title>
			<title code="0x13">MV_04.MDS    : </title>
		</titlelist>
	</game>
</gamelist>

			<rom type="file" offset="0x12">MV_03.MDS</rom>
			<rom type="file" offset="0x13">MV_04.MDS</rom>
			<rom type="file" offset="0x14">OPENING.MDS</rom>
			<rom type="file" offset="0x15">SCENARIO.MDS</rom>
			<rom type="file" offset="0x16">THEME.MDS</rom>
			<rom type="shell" offset="0">exldr_98.com</rom>
		</romlist>
		<titlelist>

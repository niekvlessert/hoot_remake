			<rom type="file" offset="0x02">MUSIC2.SWP</rom>
			<rom type="file" offset="0x03">MUSIC3.SWP</rom>
			<rom type="file" offset="0x04">MUSIC4.SWP</rom>
			<rom type="file" offset="0x05">MUSIC5.SWP</rom>
			<rom type="file" offset="0x06">MUSIC6.SWP</rom>
			<rom type="file" offset="0x07">MUSIC7.SWP</rom>
			<rom type="file" offset="0x08">MUSIC8.SWP</rom>
			<rom type="shell" offset="0">TRPSCHRN</rom>
